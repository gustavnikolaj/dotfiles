#!/usr/bin/env bash

LIGHTS=(
    10.0.0.60
    10.0.0.61
)

# The presets, and the single source of truth for them: dispatch, --help and
# the shell completion all read this table.
#
# Temperature is the raw Elgato API value, which is mireds, so Kelvin is
# 1000000 / value (143 = 7000K, 344 = 2900K). usage() derives its Kelvin
# column from that.
#
# name|brightness %|temperature|description
PRESETS=(
    "night|3|335|dim, late evening"
    "evening|10|316|evening"
    "cloudy|20|311|overcast day"
    "cloudy-warm|20|335|overcast day, warm"
    "day|40|288|daylight"
    "sunny|90|251|bright sun"
)

# set -x

# curl -s --request GET http://${LIGHTS[0]}:9123/elgato/lights --header 'Accept: application/json' | jq .
# curl -s --request GET http://${LIGHTS[0]}:9123/elgato/accessory-info --header 'Accept: application/json' | jq .
# curl -s --request GET http://${LIGHTS[0]}:9123/elgato/settings --header 'Accept: application/json' | jq .
# curl -s --request POST http://${LIGHTS[0]}:9123/elgato/identify --header 'Accept: application/json' | jq .


# PUT a light payload. Warns and succeeds if the light is unreachable, so one
# offline light does not fail the whole run.
light_put() {
    local ip=$1
    local payload=$2
    curl -s -f -m 3 --request PUT http://$ip:9123/elgato/lights \
        --header 'Accept: application/json' --data-raw "$payload" > /dev/null \
        || echo "lights: $ip unreachable" >&2
}

set_light_on() {
    light_put "$1" '{ "numberOfLights": 1, "lights": [ { "on": 1 } ] }'
}

set_light_off() {
    light_put "$1" '{ "numberOfLights": 1, "lights": [ { "on": 0 } ] }'
}

# set_light_on ${LIGHTS[0]}
# set_light_off ${LIGHTS[0]}

set_lighting() {
    local ip=$1
    local on=$2
    local brightness=$3
    local temperature=$4
    light_put "$ip" "{
        \"numberOfLights\": 1,
        \"lights\": [ { \"on\": $on, \"brightness\": $brightness, \"temperature\": $temperature } ]
    }"
}

lights_off() {
    for ip in "${LIGHTS[@]}"; do
        set_light_off $ip
    done
}

lights_on() {
    for ip in "${LIGHTS[@]}"; do
        set_light_on $ip
    done
}

# Prints 1 if lit, 0 if off or unreachable.
is_lit() {
    local n
    n=$(curl -s -f -m 3 --request GET http://$1:9123/elgato/lights --header 'Accept: application/json' \
        | jq -r '.lights[0].on // empty')
    echo "${n:-0}"
}

# is_lit

lights_toggle() {
    local lit_count=0
    local n

    for ip in "${LIGHTS[@]}"; do
        n=$(is_lit "$ip")
        (( lit_count += ${n:-0} ))
    done

    if (( lit_count > 0 )); then
        lights_off
    else
        lights_on
    fi
}

# An unreachable light reads as off, same as is_lit and lights_toggle treat it.
lights_status() {
    local ip
    for ip in "${LIGHTS[@]}"; do
        if [[ "$(is_lit "$ip")" == "1" ]]; then
            echo "$ip: on"
        else
            echo "$ip: off"
        fi
    done
}

# Echo the PRESETS row for a preset name, or return 1 if there is no such
# preset.
preset_fields() {
    local preset
    for preset in "${PRESETS[@]}"; do
        if [[ "${preset%%|*}" == "$1" ]]; then
            echo "$preset"
            return 0
        fi
    done
    return 1
}

apply_preset() {
    local row name brightness temperature description ip
    row=$(preset_fields "$1") || return 1
    IFS='|' read -r name brightness temperature description <<< "$row"

    for ip in "${LIGHTS[@]}"; do
        set_lighting "$ip" 1 "$brightness" "$temperature"
    done
}

usage() {
    local preset name brightness temperature description kelvin

    echo "Usage: ${0##*/} [preset|command]"
    echo
    echo "Control the Elgato key lights. With no argument, toggles them."
    echo
    echo "Presets:"
    for preset in "${PRESETS[@]}"; do
        IFS='|' read -r name brightness temperature description <<< "$preset"
        # Mireds to Kelvin, rounded to the nearest 50 as the Elgato UI shows it.
        kelvin=$(( (1000000 / temperature + 25) / 50 * 50 ))
        printf '  %-13s %3s%%  %5sK  %s\n' "$name" "$brightness" "$kelvin" "$description"
    done
    echo
    echo "Commands:"
    printf '  %-13s %s\n' \
        "toggle" "Toggle the lights on and off (default)" \
        "on" "Turn on, keeping the last brightness and temperature" \
        "off" "Turn off" \
        "status" "Print each light's on/off state" \
        "help" "This page"
}

# Bare names, for the shell completion in
# ~/dotfiles/bash/completion.d/lights-completion.sh.
list_options() {
    local preset
    for preset in "${PRESETS[@]}"; do
        echo "${preset%%|*}"
    done
    printf '%s\n' toggle on off status help
}

# Handle optional parameter
mode="${1:-toggle}"

case "$mode" in
    toggle)
        lights_toggle
        ;;
    on)
        lights_on
        ;;
    off)
        lights_off
        ;;
    status)
        lights_status
        ;;
    -h|--help|help)
        usage
        ;;
    --list)
        list_options
        ;;
    *)
        apply_preset "$mode" || {
            echo "lights: unknown option '$mode'" >&2
            usage >&2
            exit 1
        }
        ;;
esac

# https://github.com/adamesch/elgato-key-light-api/blob/master/resources/lights/README.md

# Temperature scale 143 - 344
# Brightness scale 0 to 100

# (*) Attempting to set a light's brightness to a low value like 2 may not do
# anything.

# (**) The 'Control Center' UI only allows color temperature changes from 2900K
# - 7000K in 50K increments. The API value is mireds: Kelvin = 1000000 / value
# (143 = 7000K, 344 = 2900K), and back again the same way.

# I want to compose high-level scenes out of this, that also adjust
# lighting on the monitor.
