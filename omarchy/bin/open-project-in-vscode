#!/bin/bash

# Pick a project, code-workspace or extra folder and open it in VS Code.
# Uses Omarchy's own menu picker; walker is an Omarchy 3 leftover and its
# elephant backend no longer runs under quattro.

EXTRAS="dotfiles"

options=()
while IFS= read -r f; do options+=("~/Projects/$f"); done < <(ls -1t ~/Projects)
while IFS= read -r f; do options+=("~/$f"); done < <(ls -1t "$HOME" | grep code-workspace)
while IFS= read -r f; do options+=("~/$f"); done <<<"$EXTRAS"

choice=$(omarchy-menu-select "Open..." "${options[@]}" -- --width 844 --maxheight 300) || exit 0

if [[ -n "$choice" ]]; then
  code -- "${choice/#\~/$HOME}"
fi
